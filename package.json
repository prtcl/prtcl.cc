{
  "private": true,
  "name": "prtcl.cc",
  "version": "0.0.0",
  "description": "Code for prtcl.cc",
  "repository": {
    "type": "git",
    "url": "https://github.com/prtcl/prtcl.cc.git"
  },
  "author": "Cory O'Brien <cory@prtcl.cc>",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "vite build --mode=production",
    "clean": "rm -rf node_modules | true && rm -r dist | true && rm -r styled-system | true",
    "deploy": "bin/deploy.sh",
    "dev": "concurrently \"convex dev\" \"vite dev --mode=development\"",
    "lint": "oxlint src convex",
    "prepare": "panda codegen",
    "prettier": "prettier src --write",
    "preview": "npm run build && concurrently \"convex dev\" \"vite preview\"",
    "typecheck": "tsgo --noEmit --pretty -p tsconfig.lib.json && tsgo --noEmit --pretty -p tsconfig.node.json && tsgo --noEmit --pretty -p scripts && tsgo --noEmit --pretty -p convex"
  },
  "dependencies": {
    "@prtcl/plonk": "^1.7.0",
    "@prtcl/plonk-hooks": "^1.7.0",
    "@react-three/fiber": "^9.7.0",
    "@react-three/postprocessing": "^3.1.0",
    "@types/three": "^0.185.4",
    "convex": "^1.38.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-icons": "^5.6.0",
    "react-use": "^17.6.0",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@pandacss/dev": "^1.11.1",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/node": "^25.7.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/yargs": "^17.0.35",
    "@typescript/native-preview": "^7.0.0-dev.20260513.1",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.1",
    "dotenv": "^17.4.2",
    "image-size": "^2.0.2",
    "oxlint": "^1.64.0",
    "postcss": "^8.5.14",
    "postcss-cli": "^11.0.1",
    "postcss-preset-env": "^11.3.0",
    "prettier": "^3.8.3",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.12",
    "vite-plugin-html": "^3.2.2",
    "vite-tsconfig-paths": "^6.1.1"
  }
}
